<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FLEXI Student Planner</title>
<style>
:root{--bg:#f4f5f9;--card:#fff;--text:#1d2030;--muted:#6b7084;--primary:#4f46e5;--border:#d0d4e0;--soft:#eceefe;--danger:#c0262d;--good:#1c7a43;--errbg:#fde8e8;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#14161f;--card:#1e2130;--text:#e8eaf2;--muted:#9aa0b8;--primary:#8b84ff;--border:#363a52;--soft:#2a2e4a;--danger:#ff7b82;--good:#55d68b;--errbg:#3a1d21;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#14161f;--card:#1e2130;--text:#e8eaf2;--muted:#9aa0b8;--primary:#8b84ff;--border:#363a52;--soft:#2a2e4a;--danger:#ff7b82;--good:#55d68b;--errbg:#3a1d21;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,sans-serif}
.wrap{max-width:820px;margin:0 auto;padding:20px 16px 56px}
.brand{margin:0;letter-spacing:2px;color:var(--primary)}
.muted{color:var(--muted);font-size:14px}
.card{background:var(--card);border-radius:12px;padding:16px;margin-bottom:14px;box-shadow:0 1px 4px rgba(0,0,0,.12)}
h3{margin:0 0 10px;font-size:16px}
input,textarea,select,button{font:inherit;color:var(--text);background:var(--card);border:1px solid var(--border);border-radius:8px;padding:9px 11px}
input,textarea,select{width:100%}
button{cursor:pointer}
button.primary{background:var(--primary);border-color:var(--primary);color:#fff}
button.danger{color:var(--danger);border-color:var(--danger)}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;gap:10px}
.row{display:flex;gap:10px}
.col{display:flex;flex-direction:column;gap:10px}
.bar-tools{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}
.bar-tools input{flex:2;min-width:140px}.bar-tools select{flex:1;min-width:120px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:14px}
.stat{background:var(--card);border-radius:12px;padding:14px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,.12)}
.stat b{display:block;font-size:26px}.stat span{font-size:13px;color:var(--muted)}
.stat.w b{color:var(--danger)}.stat.g b{color:var(--good)}
.br{display:flex;align-items:center;gap:10px;margin:6px 0;font-size:14px}
.br .l{width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.br .t{flex:1;height:10px;background:var(--soft);border-radius:99px;overflow:hidden}
.br .t div{height:100%;background:var(--primary)}
.item{display:flex;gap:12px;justify-content:space-between}
.item h4{margin:0 0 4px}.item p{margin:0 0 8px;color:var(--muted);font-size:14px}
.item.done h4{text-decoration:line-through;color:var(--muted)}
.grow{flex:1}.acts{display:flex;flex-direction:column;gap:6px;min-width:120px}
.tag{display:inline-block;font-size:12px;padding:2px 9px;border-radius:99px;background:var(--soft);color:var(--primary);margin:0 6px 4px 0}
.tag.high{background:#fde8e8;color:#a11}.tag.medium{background:#fff3d6;color:#8a5a00}.tag.low{background:#d9f5e3;color:#1c7a43}
.tag.over{background:var(--danger);color:#fff}
.err{background:var(--errbg);color:var(--danger);padding:10px 14px;border-radius:8px;margin-bottom:12px}
.note{background:var(--soft);border-radius:8px;padding:8px 12px;font-size:13px;margin-bottom:14px;color:var(--muted)}
.auth{min-height:80vh;display:grid;place-items:center}.auth .card{width:100%;max-width:380px}
a{color:var(--primary);cursor:pointer}
@media(max-width:560px){.item{flex-direction:column}.acts{flex-direction:row;flex-wrap:wrap}}
</style>
</head>
<body>
<div class="wrap" id="app"></div>
<script>
const mem={};
const store={get(k){try{return localStorage.getItem(k)}catch(e){return mem[k]??null}},
set(k,v){try{localStorage.setItem(k,v)}catch(e){mem[k]=v}},del(k){try{localStorage.removeItem(k)}catch(e){delete mem[k]}}};
const J=(k,d)=>{try{const v=JSON.parse(store.get(k));return v??d}catch(e){return d}};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function sha(s){try{const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}catch(e){return btoa(s)}}
const uid=()=>Math.random().toString(36).slice(2,10)+Date.now().toString(36);
const today=()=>new Date().toISOString().slice(0,10);
const fmt=d=>d?new Date(d+'T00:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}):'No deadline';

let session='guest',mode='dash',tasks=[],editId=null,msg='';
let F={q:'',status:'',priority:'',sort:''};
const app=document.getElementById('app');
const tKey=()=>'flexi_tasks_'+session;
const save=()=>store.set(tKey(),JSON.stringify(tasks));

function authView(m){
  const reg=m==='register';
  app.innerHTML=`<div class="auth"><form class="card col" id="authf">
  <h1 class="brand">FLEXI</h1><div class="muted">Student Planner – ${reg?'create account':'sign in'}</div>
  <div class="note">Live demo: accounts and tasks are saved only in this browser. The full Node.js + MongoDB version is in the project zip.</div>
  ${msg?`<div class="err">${esc(msg)}</div>`:''}
  ${reg?'<input id="name" placeholder="Full name" required>':''}
  <input id="email" type="email" placeholder="Email" required>
  <input id="pw" type="password" placeholder="Password${reg?' (min 6 chars)':''}" required minlength="6">
  <button class="primary" type="submit">${reg?'Register':'Login'}</button>
  <div class="muted">${reg?'Already registered? <a id="sw">Login</a>':'New here? <a id="sw">Create account</a>'}</div>
  </form></div>`;
  document.getElementById('sw').onclick=()=>{msg='';mode=reg?'login':'register';authView(mode)};
  document.getElementById('authf').onsubmit=async e=>{
    e.preventDefault();
    const email=document.getElementById('email').value.trim().toLowerCase(),pw=document.getElementById('pw').value;
    const users=J('flexi_users',{});
    if(reg){
      const name=document.getElementById('name').value.trim();
      if(pw.length<6){msg='Password must be at least 6 characters';return authView(m)}
      if(users[email]){msg='Email already registered';return authView(m)}
      users[email]={name,hash:await sha(pw)};store.set('flexi_users',JSON.stringify(users));
    }else{
      const u=users[email];
      if(!u||u.hash!==await sha(pw)){msg='Invalid email or password';return authView(m)}
    }
    msg='';session=email;store.set('flexi_session',email);mode='dash';dash();
  };
}

function dash(){
  tasks=J(tKey(),[]);
  
  app.innerHTML=`<div class="top"><div><h1 class="brand">FLEXI</h1><span class="muted">Student Planner</span></div>
  <div class="row"><button id="theme">Theme</button></div></div>
  <div class="note">Live demo: data is stored in this browser only.</div>
  <div id="stats"></div>
  <form class="card col" id="tf"><h3 id="ft">Add new task</h3>
   <input id="title" placeholder="Task title *" required>
   <textarea id="desc" rows="2" placeholder="Description"></textarea>
   <div class="row"><input id="subj" placeholder="Subject (e.g. DMGT)"><input id="due" type="date"></div>
   <div class="row"><select id="prio"><option value="low">Low priority</option><option value="medium" selected>Medium priority</option><option value="high">High priority</option></select>
   <select id="stat"><option value="todo">To do</option><option value="in-progress">In progress</option><option value="done">Done</option></select></div>
   <div class="row"><button class="primary" type="submit" id="sb">Add task</button><button type="button" id="cn" hidden>Cancel</button></div></form>
  <div class="bar-tools"><input id="fq" placeholder="Search title…">
   <select id="fs"><option value="">All status</option><option value="todo">To do</option><option value="in-progress">In progress</option><option value="done">Done</option></select>
   <select id="fp"><option value="">All priority</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select>
   <select id="fo"><option value="">Newest first</option><option value="due">Earliest deadline</option></select></div>
  <div id="list"></div>`;
  const $=id=>document.getElementById(id);
  
  $('theme').onclick=()=>{const r=document.documentElement;const dark=r.dataset.theme==='dark'||(!r.dataset.theme&&matchMedia('(prefers-color-scheme:dark)').matches);r.dataset.theme=dark?'light':'dark'};
  $('cn').onclick=resetForm;
  $('tf').onsubmit=e=>{
    e.preventDefault();
    const t={title:$('title').value.trim(),description:$('desc').value.trim(),subject:$('subj').value.trim()||'General',
      priority:$('prio').value,status:$('stat').value,dueDate:$('due').value};
    if(!t.title)return;
    if(editId){tasks=tasks.map(x=>x.id===editId?{...x,...t}:x)}else{tasks.unshift({id:uid(),createdAt:Date.now(),...t})}
    save();resetForm();refresh();
  };
  [['fq','q'],['fs','status'],['fp','priority'],['fo','sort']].forEach(([id,k])=>{$(id).oninput=e=>{F[k]=e.target.value;refresh()}});
  $('list').onclick=e=>{
    const b=e.target.closest('[data-act]');if(!b)return;
    const id=b.dataset.id,act=b.dataset.act,t=tasks.find(x=>x.id===id);
    if(act==='del'){if(confirm('Delete this task?')){tasks=tasks.filter(x=>x.id!==id);save();refresh()}}
    if(act==='edit'){editId=id;$('title').value=t.title;$('desc').value=t.description;$('subj').value=t.subject;$('due').value=t.dueDate;
      $('prio').value=t.priority;$('stat').value=t.status;$('ft').textContent='Edit task';$('sb').textContent='Update task';$('cn').hidden=false;scrollTo({top:0,behavior:'smooth'})}
    if(act==='sample'){const d=n=>new Date(Date.now()+n*864e5).toISOString().slice(0,10);
      tasks=[{id:uid(),title:'Discrete Maths assignment 2',description:'Graph theory problems',subject:'DMGT',priority:'high',status:'in-progress',dueDate:d(2)},
      {id:uid(),title:'Cryptography lab report',description:'',subject:'Cryptography',priority:'medium',status:'todo',dueDate:d(-1)},
      {id:uid(),title:'FLEXI project demo',description:'React + Node + MongoDB',subject:'FLEXI',priority:'high',status:'todo',dueDate:d(5)},
      {id:uid(),title:'Probability quiz revision',description:'',subject:'Probability',priority:'low',status:'done',dueDate:d(-3)}].map(x=>({...x,createdAt:Date.now()}));
      save();refresh()}
  };
  list_change();refresh();
}
function list_change(){document.getElementById('list').onchange=e=>{
  const s=e.target.closest('[data-st]');if(!s)return;
  tasks=tasks.map(x=>x.id===s.dataset.st?{...x,status:s.value}:x);save();refresh()}}
function resetForm(){editId=null;const $=id=>document.getElementById(id);$('tf').reset();$('ft').textContent='Add new task';$('sb').textContent='Add task';$('cn').hidden=true}

function refresh(){
  const now=today(),total=tasks.length,cnt=s=>tasks.filter(t=>t.status===s).length;
  const open=tasks.filter(t=>t.status!=='done');
  const overdue=open.filter(t=>t.dueDate&&t.dueDate<now).length;
  const wk=new Date(Date.now()+7*864e5).toISOString().slice(0,10);
  const soon=open.filter(t=>t.dueDate&&t.dueDate>=now&&t.dueDate<=wk).length;
  const rate=total?Math.round(cnt('done')/total*100):0;
  const subj={};tasks.forEach(t=>subj[t.subject]=(subj[t.subject]||0)+1);
  const subs=Object.entries(subj).sort((a,b)=>b[1]-a[1]).slice(0,6),mx=subs.length?subs[0][1]:1;
  document.getElementById('stats').innerHTML=`<div class="stats">
   <div class="stat"><b>${total}</b><span>Total</span></div><div class="stat"><b>${cnt('in-progress')}</b><span>In progress</span></div>
   <div class="stat w"><b>${overdue}</b><span>Overdue</span></div><div class="stat"><b>${soon}</b><span>Due in 7 days</span></div>
   <div class="stat g"><b>${rate}%</b><span>Completed</span></div></div>`+
   (subs.length?`<div class="card"><h3>Tasks by subject</h3>${subs.map(([s,c])=>`<div class="br"><span class="l">${esc(s)}</span><div class="t"><div style="width:${c/mx*100}%"></div></div><span>${c}</span></div>`).join('')}</div>`:'');
  let v=tasks.filter(t=>(!F.q||t.title.toLowerCase().includes(F.q.toLowerCase()))&&(!F.status||t.status===F.status)&&(!F.priority||t.priority===F.priority));
  v=F.sort==='due'?[...v].sort((a,b)=>(a.dueDate||'9999').localeCompare(b.dueDate||'9999')):[...v].sort((a,b)=>b.createdAt-a.createdAt);
  const L=document.getElementById('list');
  if(!v.length){L.innerHTML=`<p class="muted">No tasks found. Add one above.</p>`+(!total?`<button data-act="sample" data-id="">Add sample tasks</button>`:'');return}
  L.innerHTML=v.map(t=>{const od=t.dueDate&&t.status!=='done'&&t.dueDate<now;
   return `<div class="card item ${t.status==='done'?'done':''}"><div class="grow"><h4>${esc(t.title)}</h4>${t.description?`<p>${esc(t.description)}</p>`:''}
   <span class="tag">${esc(t.subject)}</span><span class="tag ${t.priority}">${t.priority}</span><span class="tag ${od?'over':''}">${od?'Overdue · ':'Due · '}${fmt(t.dueDate)}</span></div>
   <div class="acts"><select data-st="${t.id}"><option value="todo"${t.status==='todo'?' selected':''}>To do</option><option value="in-progress"${t.status==='in-progress'?' selected':''}>In progress</option><option value="done"${t.status==='done'?' selected':''}>Done</option></select>
   <button data-act="edit" data-id="${t.id}">Edit</button><button class="danger" data-act="del" data-id="${t.id}">Delete</button></div></div>`}).join('');
}
dash();
</script>
</body>
</html>
